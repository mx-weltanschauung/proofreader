# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
# Адрес отдельного слушателя /metrics (Prometheus); пусто — без слушателя /metrics
METRICS_ADDR=
# Адрес читальни, каким его видит браузер — печатается на титуле каждой
# скачанной книги (EPUB/FB2/Markdown/HTML). В docker compose можно не менять.
PUBLIC_BASE_URL=http://localhost:3100

# Экземпляр: всё, чем ваша читальня отличается от любой другой.
# Имя — в шапке, во вкладках, на страницах для краулеров, в OPDS, MCP и на
# титуле выгрузок. Пусто — «Читальня».
SITE_NAME=
# Одна фраза о собрании: инструкция MCP-сервера, описание OPDS и llms.txt.
SITE_DESCRIPTION=
# Ссылки подвала «Поддержать» и на канал новостей; знак возрастной маркировки
# (например, 18+). Пусто — не показывать.
SITE_SUPPORT_URL=
SITE_CHANNEL_URL=
SITE_AGE_RATING=
# Короткая подпись под именем в шапке; пусто — подписи нет.
SITE_TAGLINE=
# Дополнительные занятые ники через запятую (например, имена авторов корпуса),
# к базовому списку служебных имён.
RESERVED_NICKNAMES=
# Верить X-Real-IP при определении адреса читателя. true — только если перед
# бэкендом стоит прокси, перезаписывающий этот заголовок (compose, боевой).
TRUST_PROXY_HEADERS=false

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USER=proofreader
DB_PASSWORD=proofreader_password
DB_NAME=proofreader
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h
# Срок читательской сессии: пароль вводится однажды, восстановления нет.
JWT_READER_EXPIRATION=2160h

# File Storage
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE=100MB

# Admin User (initial seed)
ADMIN_EMAIL=admin@proofreader.local
ADMIN_PASSWORD=admin

# S3 / SeaweedFS Object Storage
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=proofreader
S3_AUDIO_BUCKET=proofreader-audio
S3_ACCESS_KEY=proofreader_dev
S3_SECRET_KEY=proofreader_dev_secret
S3_USE_PATH_STYLE=true
S3_PRESIGN_TTL=30m
# Origin, которым бэкенд открывает CORS бакета звука (запись человека
# заливается presigned PUT из браузера). Пусто — не трогать (SeaweedFS
# отражает любой origin сам). На боевом с внешним S3: https://lib.example.org
S3_CORS_ORIGINS=

# Внешний S3 для боевого (deploy.sh --external-s3, переливка). Ключи — только
# буквы и цифры. Локально не используются.
EXTERNAL_S3_ENDPOINT=https://s3.example.org
EXTERNAL_S3_REGION=default
EXTERNAL_S3_ACCESS_KEY=
EXTERNAL_S3_SECRET_KEY=

# Запасное хранилище только для чтения (pkg/storage.Fallback): объект, которого
# нет в основном, бэкенд читает отсюда по тому же ключу. Так локальная копия
# держит только рабочий набор сканов, а остальные читает с боевого бакета.
# Ключ лучше выдать только на чтение. Совпадение с основным — отказ старта.
#S3_FALLBACK_ENDPOINT=https://s3.example.org
#S3_FALLBACK_REGION=default
#S3_FALLBACK_BUCKET=proofreader
#S3_FALLBACK_ACCESS_KEY=
#S3_FALLBACK_SECRET_KEY=

# Каталог файлового кэша готовых глав. Пустой — кэш выключен (так идёт
# локальный запуск). В контейнере — /var/cache/proofreader на именованном томе.
PAGE_CACHE_DIR=

# Public S3 endpoint used ONLY for presigned URLs (must be browser-reachable).
# Leave empty for local runs (falls back to S3_ENDPOINT). In docker compose the
# backend sets this to http://localhost:8333 while S3_ENDPOINT is the internal host.
S3_PUBLIC_ENDPOINT=

# Статическая читальня — вся читальня одним архивом (scripts/static-release.sh).
# Публичный адрес каталога, где лежат архивы и manifest.json; из него бэкенд
# читает сведения для /help#offline. Пусто — /api/static-archive отвечает 404.
STATIC_ARCHIVE_URL=
