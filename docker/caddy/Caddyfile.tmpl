# Шаблон боевого Caddyfile. Подстановку делает render_caddyfile из
# scripts/bootstrap.sh: домен, поддомен хранилища и строка с адресом для
# Let's Encrypt. Строка с адресом при пустом значении удаляется целиком.
# Блок хранилища между строками-маркерами рендер удаляет целиком, если поддомена хранилища нет (внешний S3), и удаляет одни маркеры, если он есть.
# Литеральные плейсхолдеры в комментариях писать нельзя — sed подставит
# значения и сюда, а в ветке без адреса удалит эту строку.
#
# Строка с сертификатом появляется, только если в CONFIG_DIR/caddy-certs
# лежит пара origin.pem/origin.key — Origin Certificate от Cloudflare. Тогда
# ACME для основного домена не нужен вовсе, и это не украшение: за
# проксированием Cloudflare проверка TLS-ALPN невозможна в принципе, а
# HTTP-01 работает лишь пока у Cloudflare выключен «Always Use HTTPS».
# Молчаливый отказ в продлении при режиме Full (strict) кладёт сайт целиком.
# Файлов нет — строка удаляется, и Caddy берёт сертификат у Let's Encrypt,
# как на сервере без Cloudflare перед ним.
{
	admin off
	# Читальня стоит за Cloudflare, поэтому прокси перед бэкендом два.
	# Caddy по умолчанию не доверяет X-Forwarded-For от недоверенного
	# соседа и заменяет его адресом соседа — то есть адресом узла
	# Cloudflare. Настоящий адрес читателя теряется ЗДЕСЬ, до nginx, и
	# set_real_ip_from в его конфиге восстановить уже нечего: доверять
	# Cloudflare должны оба звена, а не одно. Цена потери — предел «5
	# писем в час на адрес» из internal/api/feedback становится общим на
	# весь узел: первые пять писем закрывают приём остальным читателям
	# за тем же узлом. Список — https://www.cloudflare.com/ips-v4,
	# снят 28.08.2026, у Cloudflare меняется редко, но меняется.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
__ACME_EMAIL_LINE__
}

__DOMAIN__ {
__TLS_LINE__
	encode zstd gzip
	# Журнал доступа на слое Caddy. Nginx фронта видит только то, что уже
	# прошло TLS: соединение, оборвавшееся на рукопожатии, в его журнал не
	# попадает никогда. Этой слепоты хватило, чтобы 28.08.2026 полдня искать
	# «почему краулер Телеграма получает плохой ответ» там, где он не
	# приходил вовсе — а понять это можно было только отсюда.
	log {
		output stdout
		format console
	}
	# Внутри фронта nginx сам проксирует /api на backend:8080.
	reverse_proxy frontend:80
}

#S3-BLOCK-BEGIN
__S3_DOMAIN__ {
	# Presigned-ссылки хранилища: превью страниц и оригиналы, звук (цель
	# редиректов /api/audio/…, GET диапазонами) и заливка звука worker'ом
	# (presigned PUT). Host передаётся как пришёл — на нём держится подпись
	# presigned-ссылок; переписать его значит сломать их все.
	reverse_proxy seaweedfs:8333
}
#S3-BLOCK-END
